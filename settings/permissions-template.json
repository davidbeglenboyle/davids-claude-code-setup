{
  "permissions": {
    "allow": [
      "// ═══════════════════════════════════════════════════════════════",
      "// PERMISSIONS TEMPLATE",
      "// Customize this for your workflow. Comments (// lines) are ignored.",
      "// Keep it NARROW: anything approved here runs with no prompt, including",
      "// when a web page, email or document has slipped instructions into the",
      "// conversation. Prompting is the protection; approve only what is harmless.",
      "// ═══════════════════════════════════════════════════════════════",

      "// ─────────────────────────────────────────────────────────────────",
      "// GIT OPERATIONS (read-only forms)",
      "// Broad Bash(git:*) also covers hooks, aliases and destructive commands.",
      "// ─────────────────────────────────────────────────────────────────",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",

      "// ─────────────────────────────────────────────────────────────────",
      "// PACKAGE MANAGERS, INTERPRETERS AND NETWORK CLIENTS: deliberately NOT pre-approved.",
      "// npm, npx, pip, brew, python and node run arbitrary code (install scripts,",
      "// -c, -e); curl and wget can send your files to any host; sqlite3 runs",
      "// arbitrary SQL. Let them prompt, or approve one exact command,",
      "// e.g. Bash(npm run test).",
      "// ─────────────────────────────────────────────────────────────────",

      "// ─────────────────────────────────────────────────────────────────",
      "// FILE OPERATIONS",
      "// ─────────────────────────────────────────────────────────────────",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",

      "// ─────────────────────────────────────────────────────────────────",
      "// TEXT PROCESSING",
      "// ─────────────────────────────────────────────────────────────────",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",

      "// ─────────────────────────────────────────────────────────────────",
      "// MACOS UTILITIES",
      "// ─────────────────────────────────────────────────────────────────",
      "Bash(pbcopy:*)",
      "Bash(pbpaste:*)",
      "Bash(mdfind:*)",

      "// ─────────────────────────────────────────────────────────────────",
      "// WEB ACCESS",
      "// Add domains you frequently need to access",
      "// ─────────────────────────────────────────────────────────────────",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:developer.mozilla.org)",

      "// ─────────────────────────────────────────────────────────────────",
      "// SKILLS",
      "// Add skills you want auto-approved",
      "// ─────────────────────────────────────────────────────────────────",
      "Skill(chart-design)",
      "Skill(frontend-design)",

      "// ─────────────────────────────────────────────────────────────────",
      "// FILE WRITES",
      "// Keep this narrow. Write(~/.claude/*) would let injected text rewrite",
      "// your own settings, hooks and skills. Allow a project scratch folder.",
      "// ─────────────────────────────────────────────────────────────────",
      "Write(./tmp/*)"
    ],
    "deny": [
      "// ─────────────────────────────────────────────────────────────────",
      "// BLOCKED COMMANDS",
      "// These are explicitly blocked, not just unapproved.",
      "// See settings/SAFETY-TRASH-OVER-RM.md for rationale.",
      "// A deny rule on rm is a speed bump, not a wall: other tools can still",
      "// delete files. Keep important work in git and backed up.",
      "// ─────────────────────────────────────────────────────────────────",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)"
    ]
  },

  "// Note": "Copy relevant sections to your ~/.claude/settings.json"
}
